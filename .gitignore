__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.pytest_tmp/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

.venv/
venv/
.env
node_modules/
ui/node_modules/
ui/dist/

.serena/
.claude/
.agents/

test_scenes/
validation_output/
review_packages/
migration_artifacts/
external_datasets/
local_datasets/
atlas_ui_projects/
atlas_camera.egg-info/
atlas_exports/
examples/review_packages/*
!examples/review_packages/.gitkeep

*.exr
*.abc
*.fbx
*.usdc
*.blend
*.ma
*.mb

# Model weights / checkpoints — never commit these to a ComfyUI node repo
*.safetensors
*.ckpt
*.pth
*.onnx
*.gguf

# Large or generated images should stay out of git. Small hand-written fixtures
# in tests/fixtures are allowed.
*.png
*.jpg
*.jpeg
*.tif
*.tiff
!tests/fixtures/*
# Brand/registry assets are hand-authored and must ship (the registry Icon URL
# points at assets/atlas_camera_icon.png).
!assets/*.png
!examples/images/.gitkeep
# Stock plates for the shipped example workflows. Committed deliberately and
# kept SMALL (1280x720 jpg, ~250 KB each): before 2026-07-31 examples/images/
# was fully ignored, so eight shipped workflows pointed at plates a fresh clone
# never had. An example that cannot run is worse than no example.
# Interior + exterior because one plate cannot serve both: the exterior carries
# a ground plane, a street grid and buildings, which the scale, massing and
# grid work all need.
!examples/images/spacehangar.jpg
!examples/images/ghosttown.jpg
# Urban exterior with a real street grid. Neither of the other two has one:
# ghosttown is dirt roads (24% grid coherence, below the 35% floor) and
# spacehangar is an interior, so AtlasBlockoutMassing correctly REFUSES on both.
# Downscaled from the 7360x4912 original to 1280x854; the grid survives at 62%.
# The mask is shipped with it because without one the fit eats the tower facades
# and lands 5 degrees out - measured 3.66 vs 87.7.
!examples/images/newyork_birdseye.jpg
!examples/images/newyork_birdseye_ground_mask.png

# Session/tooling artifacts
.playwright-mcp/
.pytest_tmp_atlas_output_desk*/

# Personal documents — never publish
docs/applications/

# Doc-embedded scene thumbnails are the exception to the *.jpg ban
!docs/images/*.jpg
!docs/images/*.svg

# Python packaging artifacts (pip wheel / python -m build)
dist/
build/
*.egg-info/

# Codex machine-specific tooling — never commit
.codex/
.worktrees/

# Graphify knowledge graph — a local tooling artifact, kept on disk but never
# published (it also bloated the Registry archive by ~12 MB).
graphify-out/

# Development documentation — worklogs, design plans, research notes and the
# generated guide artifacts. Kept locally; the published tree carries only the
# user-facing docs (README, INSTALL, CHANGELOG, docs/*.md).
docs/dev/
docs/artifacts/

# Local scratch workflows — machine-specific experiments, A/B labs and
# one-off test graphs. The SHIPPING examples in examples/*.json are pinned by
# tests/test_example_workflows.py; these are not, and a `git add -A` swept
# them in once already.
examples/local/

# Golden-frame gate: per-failure debug renders are generated on demand.
# The BASELINES in tests/golden/*.png are committed deliberately.
tests/golden/_failures/

# Golden-frame BASELINES are committed on purpose — they are the test
# fixtures, not build output. The repo-wide *.png rule above would swallow
# them silently and leave the gate with nothing to compare against, which
# only shows up on a fresh clone.
!tests/golden/*.png

# Git bundles used to hand the repo to another machine. Build artifacts,
# not source — and an 11 MB binary committed by accident is painful to
# remove from history afterwards.
*.bundle
